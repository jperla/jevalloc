 // set `right_page_reclaimed` to `true` if it reclaimed a page of the right `block_size` that was not full.
 static mi_segment_t* mi_segment_reclaim(mi_segment_t* segment, mi_heap_t* heap, size_t requested_block_size, bool* right_page_reclaimed, mi_segments_tld_t* tld) {
   if (right_page_reclaimed != NULL) { *right_page_reclaimed = false; }
+  // jevalloc: prepare matching heaps before taking ownership of any page. Metadata
+  // allocation can itself attempt reclamation; defer nested attempts safely.
+  extern mi_atomic(bool) _mi_jev_tags_enabled;
+  if (mi_atomic_load_acquire(&_mi_jev_tags_enabled)) {
+  mi_heap_t* backing = heap->tld->heap_backing;
+  if (!backing->no_reclaim) {
+    backing->no_reclaim = true;
+    const mi_slice_t* tag_end;
+    mi_slice_t* tag_slice = mi_slices_start_iterate(segment, &tag_end);
+    bool tags_ready = true;
+    while (tag_slice < tag_end) {
+      if (mi_slice_is_used(tag_slice)) {
+        uint8_t tag = mi_slice_to_page(tag_slice)->heap_tag;
+        if (_mi_heap_by_tag(heap, tag) == NULL && mi_heap_new_ex(tag, false, heap->arena_id) == NULL) {
+          tags_ready = false; break;
+        }
+      }
+      tag_slice += tag_slice->slice_count;
+    }
+    backing->no_reclaim = false;
+    if (!tags_ready) { _mi_arena_segment_mark_abandoned(segment); return NULL; }
+  }
+  else { _mi_arena_segment_mark_abandoned(segment); return NULL; }
+  }
+
   // can be 0 still with abandoned_next, or already a thread id for segments outside an arena that are reclaimed on a free.
   mi_assert_internal(mi_atomic_load_relaxed(&segment->thread_id) == 0 || mi_atomic_load_relaxed(&segment->thread_id) == _mi_thread_id());
