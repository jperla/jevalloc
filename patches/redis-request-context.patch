+/* Application-owned, bucketed request context. Networking/parser allocations
+ * precede this dispatch hook and intentionally carry no command context. */
+static _Thread_local char jev_command_context[256];
+static void jevCommandContext(client *c) {
+    if (!jev_context_set) return;
+    char prefix[17] = "";
+    int key = c->cmd->firstkey;
+    if (key > 0 && key < c->argc && sdsEncodedObject(c->argv[key])) {
+        sds value = c->argv[key]->ptr;
+        size_t n = sdslen(value), i;
+        /* Collapse a trailing numeric ID before truncating the family. */
+        size_t end = 0;
+        while (end < n && value[end] != ':') end++;
+        size_t digits = end;
+        while (digits && value[digits-1] >= '0' && value[digits-1] <= '9') digits--;
+        n = digits;
+        for (i = 0; i < n && i < 15; i++) {
+            unsigned char ch = value[i];
+            prefix[i] = ch > 32 && ch < 127 ? ch : '_';
+        }
+        if (digits < end) prefix[i++] = '#';
+        prefix[i] = 0;
+    }
+    int expiry = !strcasecmp(c->cmd->name,"expire") ||
+        !strcasecmp(c->cmd->name,"pexpire") ||
+        !strcasecmp(c->cmd->name,"expireat") ||
+        !strcasecmp(c->cmd->name,"pexpireat") ||
+        !strcasecmp(c->cmd->name,"setex") || !strcasecmp(c->cmd->name,"psetex");
+    int value_index = 0;
+    if (!strcasecmp(c->cmd->name,"set")) {
+        value_index = 2;
+        for (int i = 3; i < c->argc; i++) if (sdsEncodedObject(c->argv[i])) {
+            char *arg = c->argv[i]->ptr;
+            if (!strcasecmp(arg,"ex") || !strcasecmp(arg,"px") ||
+                !strcasecmp(arg,"exat") || !strcasecmp(arg,"pxat") ||
+                !strcasecmp(arg,"keepttl")) expiry = 1;
+        }
+    } else if (!strcasecmp(c->cmd->name,"setex") || !strcasecmp(c->cmd->name,"psetex")) value_index = 3;
+    size_t size = value_index && value_index < c->argc ? stringObjectLen(c->argv[value_index]) : 0;
+    const char *bucket = !size ? "none" : size <= 64 ? "le64" : size <= 256 ? "le256" : size <= 1024 ? "le1024" : size <= 4096 ? "le4096" : "gt4096";
+    snprintf(jev_command_context,sizeof(jev_command_context),"cmd=%s key=%s expiry=%s size=%s",c->cmd->name,prefix,expiry?"yes":"no",bucket);
+    jev_context_set(jev_command_context);
+}
